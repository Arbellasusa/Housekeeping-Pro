rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function getRole() {
      return getUserDoc().role;
    }
    function isRole(r) {
      return isAuth() && getRole() == r;
    }
    function isAtLeast(level) {
      // Levels: housekeeper=1, almacenero=2, supervisor=3, gerente=4, admin=5
      let levels = {'housekeeper': 1, 'almacenero': 2, 'supervisor': 3, 'gerente': 4, 'admin': 5};
      return isAuth() && levels[getRole()] >= level;
    }
    function sameHotel(data) {
      return data.hotel == getUserDoc().hotelCode;
    }

    // ── Users ─────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && (uid() == userId || isAtLeast(3));
      allow create: if isAuth() && uid() == userId;
      allow update: if isAuth() && (uid() == userId || isAtLeast(5));
      allow delete: if isAtLeast(5);
    }

    // ── Requests ──────────────────────────────────
    match /requests/{reqId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == uid() ||
        isAtLeast(2)  // almacenero and above can update status
      );
      allow delete: if isAtLeast(4);
    }

    // ── Inventory ─────────────────────────────────
    match /inventory/{prodId} {
      allow read:   if isAuth();
      allow create: if isAtLeast(2);  // almacenero+
      allow update: if isAtLeast(2);
      allow delete: if isAtLeast(3);
    }

    // ── Movements (Kardex) ────────────────────────
    match /movements/{movId} {
      allow read:   if isAuth();
      allow create: if isAuth();  // auto-created by requests
      allow update: if isAtLeast(4);  // only gerente+ can modify history
      allow delete: if isAtLeast(5);
    }

    // ── Chat ──────────────────────────────────────
    match /chat/{msgId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isAtLeast(4);
    }

    // ── Alerts ────────────────────────────────────
    match /alerts/{alertId} {
      allow read:   if isAuth();
      allow create: if isAtLeast(2);
      allow update: if isAtLeast(2);
      allow delete: if isAtLeast(3);
    }

    // ── Settings ─────────────────────────────────
    match /settings/{doc} {
      allow read:   if isAuth();
      allow write:  if isAtLeast(3);
    }

    // ── Reports ────────────────────────────────────
    match /reports/{reportId} {
      allow read:   if isAuth();
      allow create: if isAtLeast(2);
      allow update: if isAtLeast(3);
      allow delete: if isAtLeast(4);
    }
  }
}
